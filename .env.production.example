# Settings for docker-compose.prod.yml. Copy to .env.production and fill in. Never commit the copy.

# The address people will type, with https and no trailing slash.
PUBLIC_URL=https://atlas.example.com

# Two long random values. Make each with: openssl rand -base64 32
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=

# Email. Leave as console to print messages to the log (nobody can confirm an address that way);
# for real sending use resend with a key and a sender on a domain you have verified at resend.com.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Atlas & Ink <hello@atlas.example.com>

# Public reader wikis stay off until you have terms and a takedown process (see USER_TASKS.md).
PUBLIC_WIKIS=false
# Shown on wiki pages as "Report this wiki".
ABUSE_EMAIL=
