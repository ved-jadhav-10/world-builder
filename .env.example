# Postgres from docker-compose.yml
DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas
TEST_DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas_test

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
# Public origin the browser uses (Vite dev server proxies /api to the API)
BETTER_AUTH_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173

API_PORT=3000

# Where uploaded map images and tiles are kept (relative paths start at the repo root)
# STORAGE_DIR=storage
