# Postgres from docker-compose.yml
DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas
TEST_DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas_test

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
# Public origin the browser uses (Vite dev server proxies /api to the API)
BETTER_AUTH_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173

API_PORT=3000

# Where uploaded map images and tiles are kept (relative paths start at the repo root)
# STORAGE_DIR=storage

# Email. `console` prints each message (verification, password reset, invites) to the API log.
# For real sending use `resend`, with a key and a sender on a domain verified at resend.com.
# EMAIL_PROVIDER=console
# RESEND_API_KEY=
# EMAIL_FROM=Atlas & Ink <hello@your-domain.com>
# Refuse sign-in until the address is confirmed. Defaults to true when EMAIL_PROVIDER is not console.
# REQUIRE_EMAIL_VERIFICATION=false
# Set to true behind a proxy or load balancer so rate limits see each visitor's real address.
# TRUST_PROXY=false
